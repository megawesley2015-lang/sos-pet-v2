# SOS Pet - Variáveis de Ambiente

# Supabase Configuration (PUBLIC - usadas no cliente)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Site URL (para callbacks de autenticação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# === IMPORTANTE: SEGURANÇA ===
# ⚠️  NUNCA exponha chaves de servidor com NEXT_PUBLIC_
# ⚠️  Adicione .env.local no .gitignore
# ⚠️  Configure as variáveis na Vercel antes do deploy

